---
import Rich from './Rich.astro';
import type { Dict } from '../i18n';

interface Props { t: Dict }
const { t } = Astro.props;
const f = t.form;
const topics = Object.entries(f.topics) as [string, string][];
const sectors = Object.entries(f.sectors) as [string, string][];
---
<section class="request" id="request" aria-labelledby="request-h">
  <div class="wrap r-grid">
    <div class="r-head">
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="request-h">{f.heading}</h2>
      <p>{f.intro}</p>
      <div class="next">
        <h3>{f.nextTitle}</h3>
        <ol>{f.next.map((n) => <li><Rich text={n} /></li>)}</ol>
      </div>
    </div>

    <div class="r-body">
      <div class="error-summary" role="alert" tabindex="-1" hidden data-error-summary>
        <h3>{f.errorsTitle}</h3>
        <ul></ul>
      </div>

      <form method="post" action="#request" novalidate data-form data-errors={JSON.stringify(f.errors)}>
        <fieldset class="topics">
          <legend>{f.topicLegend}</legend>
          <div class="pills">
            {topics.map(([k, label], i) => (
              <label class="pill"><input type="radio" name="topic" value={k} checked={i === 0} /><span>{label}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label for="f-location">{f.location}</label>
          <p class="hint" id="h-location">{f.locationHint}</p>
          <p class="field-error" id="e-location" hidden></p>
          <input id="f-location" name="location" type="text" autocomplete="off" aria-describedby="h-location e-location" />
        </div>

        <div class="row">
          <div class="field">
            <label for="f-sector">{f.sector}</label>
            <p class="field-error" id="e-sector" hidden></p>
            <select id="f-sector" name="sector" aria-describedby="e-sector">
              <option value="">{f.sectorChoose}</option>
              {sectors.map(([k, label]) => <option value={k}>{label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-need">{f.need} <span class="opt">({f.optional})</span></label>
            <p class="field-error" id="e-need" hidden></p>
            <input id="f-need" name="need" type="text" inputmode="numeric" autocomplete="off" aria-describedby="e-need" />
          </div>
        </div>

        <div class="row">
          <div class="field">
            <label for="f-name">{f.name}</label>
            <p class="field-error" id="e-name" hidden></p>
            <input id="f-name" name="name" type="text" autocomplete="name" aria-describedby="e-name" />
          </div>
          <div class="field">
            <label for="f-org">{f.org} <span class="opt">({f.optional})</span></label>
            <input id="f-org" name="org" type="text" autocomplete="organization" />
          </div>
        </div>

        <div class="field">
          <label for="f-email">{f.email}</label>
          <p class="field-error" id="e-email" hidden></p>
          <input id="f-email" name="email" type="email" autocomplete="email" spellcheck="false" aria-describedby="e-email" />
        </div>

        <div class="field">
          <label for="f-message">{f.message}</label>
          <p class="hint" id="h-message">{f.messageHint}</p>
          <p class="field-error" id="e-message" hidden></p>
          <textarea id="f-message" name="message" rows="4" aria-describedby="h-message e-message"></textarea>
        </div>

        <div class="field check">
          <p class="field-error" id="e-consent" hidden></p>
          <label><input type="checkbox" name="consent" id="f-consent" aria-describedby="e-consent" /> <span>{f.consent}</span></label>
        </div>

        <button class="btn btn-send" type="submit" disabled data-submit>{f.submit}</button>
        <noscript><p class="hint">{f.noscript}</p></noscript>
      </form>

      <div class="done" role="status" tabindex="-1" hidden data-done>
        <h3>{f.doneTitle}</h3>
        <p>{f.doneBody}</p>
        <dl data-done-list></dl>
        <button class="btn btn-ghost-light" type="button" data-edit>{f.doneAgain}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .request { background: var(--ink); color: var(--fog-1); padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .request h2 { color: var(--fog-0); }
  .request .eyebrow { color: var(--sand); }
  .r-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); }
  .r-head { display: grid; gap: 1rem; align-content: start; }
  .r-head > p:last-of-type { color: color-mix(in oklch, var(--fog-1) 85%, transparent); max-width: 40ch; }
  .next { margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in oklch, var(--fog-1) 25%, transparent); }
  .next h3 { font-size: var(--step-0); font-family: var(--font-body); font-variation-settings: normal; letter-spacing: 0; margin-bottom: 0.75rem; color: var(--sand); }
  .next ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; counter-reset: n; }
  .next li { counter-increment: n; display: grid; grid-template-columns: 2rem 1fr; gap: 0.5rem; max-width: 36ch; color: color-mix(in oklch, var(--fog-1) 90%, transparent); }
  .next li::before { content: counter(n); display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1.5px solid var(--water-soft); color: var(--water-soft); font-weight: 700; font-size: 0.85rem; }
  .request :global([data-claims='on']) .claim, :global([data-claims='on']) .request :global(.claim) { color: var(--ink); }

  form { display: grid; gap: 1.15rem; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend, label { font-weight: 700; }
  legend { margin-bottom: 0.5rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pill { position: relative; font-weight: 600; }
  .pill input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pill span { display: inline-flex; align-items: center; min-height: 40px; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1.5px solid color-mix(in oklch, var(--fog-1) 35%, transparent); transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out); }
  .pill input:checked + span { background: var(--fog-0); color: var(--ink); border-color: var(--fog-0); }
  .pill input:focus-visible + span { outline: 3px solid var(--water-soft); outline-offset: 2px; }

  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.15rem; }
  .field { display: grid; gap: 0.35rem; align-content: start; }
  .opt { font-weight: 400; color: color-mix(in oklch, var(--fog-1) 70%, transparent); }
  .hint { font-size: 0.86rem; color: color-mix(in oklch, var(--fog-1) 75%, transparent); }
  input[type='text'], input[type='email'], select, textarea {
    width: 100%; min-height: 46px; padding: 0.6rem 0.75rem; border-radius: var(--radius);
    border: 1.5px solid color-mix(in oklch, var(--fog-1) 30%, transparent); background: oklch(0.29 0.016 255); color: var(--fog-0);
    font: inherit;
  }
  textarea { resize: vertical; min-height: 7rem; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--fog-1) 50%), linear-gradient(-45deg, transparent 50%, var(--fog-1) 50%); background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 2.2rem; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--water-soft); outline-offset: 1px; }
  [aria-invalid='true'] { border-color: oklch(0.72 0.15 30) !important; border-width: 2px !important; }
  .field-error { color: oklch(0.82 0.11 35); font-weight: 700; font-size: 0.9rem; }
  .check label { display: flex; gap: 0.6rem; align-items: start; font-weight: 500; }
  .check input { width: 22px; height: 22px; margin-top: 0.1rem; accent-color: var(--water-soft); flex: none; }

  .btn-send { justify-self: start; background: var(--water-soft); color: var(--ink); }
  .btn-send:hover { background: var(--fog-0); }
  .btn-send:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-ghost-light { background: transparent; color: var(--fog-0); border-color: color-mix(in oklch, var(--fog-1) 45%, transparent); }

  .error-summary { border: 2px solid oklch(0.72 0.15 30); border-radius: 8px; padding: 1rem 1.1rem; margin-bottom: 1.25rem; }
  .error-summary h3 { margin-bottom: 0.5rem; }
  .error-summary ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.25rem; }
  .error-summary :global(a) { color: oklch(0.86 0.1 35); font-weight: 700; }
  .error-summary :global(a:hover) { color: var(--fog-0); }

  .done { display: grid; gap: 0.8rem; padding: 1.25rem; border-radius: 10px; background: oklch(0.29 0.016 255); }
  .done h3 { font-size: var(--step-2); color: var(--water-soft); }
  .done dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0; }
  .done dt { font-weight: 700; color: color-mix(in oklch, var(--fog-1) 75%, transparent); }
  .done dd { margin: 0; overflow-wrap: anywhere; }
  .done .btn { justify-self: start; }

  @media (max-width: 860px) { .r-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .row { grid-template-columns: minmax(0, 1fr); } }
</style>
