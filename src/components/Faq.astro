---
import Rich from './Rich.astro';
import type { Dict } from '../i18n';

interface Props { t: Dict }
const { t } = Astro.props;
---
<section class="faq" id="faq" aria-labelledby="faq-h">
  <div class="wrap f-grid">
    <div>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2 id="faq-h">{t.faq.heading}</h2>
    </div>
    <div class="items">
      {t.faq.items.map((it, i) => (
        <details open={i === 0}>
          <summary><span>{it.q}</span><span class="icon" aria-hidden="true"></span></summary>
          <p><Rich text={it.a} /></p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .f-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); }
  .items { border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 56px; padding: 0.9rem 0; cursor: pointer; font-weight: 700; font-size: var(--step-1); line-height: 1.25; }
  summary::-webkit-details-marker { display: none; }
  .icon { flex: none; position: relative; width: 18px; height: 18px; }
  .icon::before, .icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: var(--ink); transition: transform 200ms var(--ease-out); }
  .icon::after { transform: rotate(90deg); }
  details[open] .icon::after { transform: rotate(0deg); }
  details p { padding: 0 0 1.1rem; max-width: 62ch; color: var(--ink-2); }
  @media (max-width: 860px) { .f-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
