---
import '../styles/global.css';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // '/' or '/fr/'
}
const { lang, title, description, path } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const alt = { en: '/', fr: '/fr/' };
---
<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      {
        // 'js' turns on the enhanced layout before first paint. If app.ts never
        // marks the page ready (failed to load or threw), fall back to the no-JS layout.
        const d = document.documentElement;
        d.classList.add('js', 'fonts-wait');
        setTimeout(() => d.classList.remove('fonts-wait'), 1000);
        addEventListener('load', () => { if (!d.classList.contains('ready')) d.classList.remove('js'); });
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="en-CA" href={site + alt.en} />
    <link rel="alternate" hreflang="fr-CA" href={site + alt.fr} />
    <link rel="alternate" hreflang="x-default" href={site + alt.en} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + path} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta name="theme-color" content="#f9f7f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <script is:inline>
      // The fonts are inlined but decode a moment after the first layout. Hold the page
      // hidden until they are ready (1 s at most), so the headline never reflows.
      {
        const show = () => document.documentElement.classList.remove('fonts-wait');
        Promise.all(['800 1em "Archivo Variable"', '1em "Schibsted Grotesk Variable"'].map((f) => document.fonts.load(f))).then(show, show);
      }
    </script>
    <slot />
  </body>
</html>
